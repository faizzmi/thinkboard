import { Link, useLocation, useNavigate } from "react-router-dom";
import {
  BookOpenIcon,
  SearchIcon,
  KeyboardIcon,
  LayoutDashboardIcon,
  StickyNoteIcon,
  PlusIcon,
} from "lucide-react";
import { useAuth } from "../context/useAuth";
